<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light">
        <item name="android:colorPrimary">@color/card_bg</item>
        <item name="android:colorPrimaryDark">@color/purple_dark</item>
        <item name="android:colorAccent">@color/purple</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:actionBarStyle">@style/AppActionBar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/purple_dark</item>
        <item name="android:navigationBarColor">@color/card_bg</item>
    </style>

    <style name="AppActionBar" parent="android:Widget.Material.ActionBar.Solid">
        <item name="android:background">@color/card_bg</item>
        <item name="android:titleTextStyle">@style/AppActionBarTitle</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="AppActionBarTitle" parent="android:TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">@color/purple</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppActionBarSubtitle" parent="android:TextAppearance.Material.Widget.ActionBar.Subtitle">
        <item name="android:textColor">@color/purple_soft</item>
    </style>
</resources>
